# Used only when running the Manager directly outside Docker Compose.
# DATABASE_URL, when set, takes precedence over the separate PG* values.
# Compose uses MANAGER_DATABASE_URL for an intentional external PostgreSQL URL
# and ignores old experimental DATABASE_URL values.
DATABASE_URL=
MANAGER_DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ekuiper_manager
PGUSER=ekuiper_manager
PGPASSWORD=ekuiper_manager

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MANAGER_SECRET_KEY=

# Public browser origin, including scheme and optional port.
MANAGER_ORIGIN=http://localhost:3000

SESSION_TTL_HOURS=12
DATABASE_POOL_SIZE=10
EKUIPER_API_TIMEOUT=30000

# Optional human-in-the-loop assistant. The base stack has no AI dependency and
# remains fully usable while disabled. Use an OpenAI-compatible chat completions
# endpoint; provider credentials are kept inside the Manager container.
AI_ASSISTANT_ENABLED=false
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_AGENT_TIMEOUT_MS=90000
AI_MAX_TOKENS=1200
AI_MAX_TOOL_ROUNDS=6
AI_MAX_TOOL_CALLS=16
